# .env.example -- committed. Copy to .env.local (git-ignored) and change the passwords.

# Schema owner: used ONLY by `npm run db:migrate` and `npm run db:seed`
POSTGRES_USER=lecturelens_owner
POSTGRES_PASSWORD=change-me
MIGRATION_DATABASE_URL=postgres://lecturelens_owner:change-me@localhost:5432/lecturelens

# Passwords given to the two least-privilege login roles when 100_roles_rls.sql runs
APP_DB_PASSWORD=change-me
ANALYST_DB_PASSWORD=change-me

# What the Next.js server connects as at runtime (the least-privilege role, NOT the owner)
DATABASE_URL=postgres://lecturelens_app:change-me@localhost:5432/lecturelens

# Signs the session cookie. Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=run-npx-auth-secret

# Embeddings: "minilm" (real model, default). "hash" is a model-free stand-in for offline tests only.
EMBED_BACKEND=minilm

# Demo accounts created by `npm run db:seed` (password for all): demo1234
#   admin@pes.edu   admin
#   rao@pes.edu     instructor (CS301)    iyer@pes.edu   instructor (CS302)    menon@pes.edu  instructor (CS303)
#   asha@pes.edu    student (CS301)       ben@pes.edu    student (CS302)       chitra@pes.edu student (CS303)
