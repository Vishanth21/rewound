%% LectureLens ER diagram. Source for docs/er_diagram.png and docs/er_diagram.svg.
%% Re-render after a schema change:
%%   npx -p @mermaid-js/mermaid-cli mmdc -i docs/er_diagram.mmd -o docs/er_diagram.png -b white -s 2
erDiagram
    app_user ||--o{ course_instructor : "teaches"
    course   ||--|{ course_instructor : "taught by (at least 1)"
    course   ||--o{ lecture : "contains"
    app_user ||--o{ lecture : "creates"
    app_user ||--o{ enrollment : "enrolls"
    course   ||--o{ enrollment : "has"
    lecture  ||--o| transcript : "has"
    app_user ||--o{ transcript : "uploads"
    transcript ||--o{ transcript_chunk : "split into"
    app_user ||--o{ access_request : "requests"
    app_user |o--o{ access_request : "decides"
    lecture  ||--o{ access_request : "requested for"
    app_user |o--o{ search_log : "searches"
    search_log ||--o{ search_hit : "surfaces"
    lecture  ||--o{ search_hit : "appears in"

    app_user {
        int user_id PK
        varchar email UK "lower(email) unique"
        varchar full_name
        text password_hash "bcrypt only"
        user_role role "student | instructor | admin"
        timestamptz created_at
    }
    course {
        int course_id PK
        varchar code UK
        varchar title
        smallint semester
        timestamptz created_at
    }
    course_instructor {
        int course_id PK, FK
        int instructor_id PK, FK "role = instructor"
    }
    enrollment {
        int student_id PK, FK "role = student"
        int course_id PK, FK
        timestamptz enrolled_at
    }
    lecture {
        int lecture_id PK
        int course_id FK, UK "unique with lecture_no"
        smallint lecture_no UK
        varchar title
        char youtube_video_id
        int duration_sec
        date delivered_on
        varchar description
        int created_by FK
        timestamptz created_at
    }
    transcript {
        int lecture_id PK, FK
        int uploaded_by FK "sole approver"
        varchar source_format "srt | vtt | json"
        text raw_text
        int segment_count
        varchar status "chunked | indexed"
        timestamptz uploaded_at
    }
    transcript_chunk {
        bigint chunk_id PK
        int lecture_id FK, UK "unique with seq_no"
        int seq_no UK
        numeric start_sec
        numeric end_sec
        text content
        vector embedding "384-d, HNSW"
        tsvector tsv "generated, GIN"
    }
    access_request {
        int request_id PK
        int student_id FK
        int lecture_id FK
        varchar reason
        request_status status "pending | approved | rejected"
        timestamptz requested_at
        int decided_by FK
        timestamptz decided_at
        timestamptz expires_at
    }
    search_log {
        bigint search_id PK
        int user_id FK
        varchar query_text
        varchar mode "semantic | keyword"
        timestamptz searched_at
    }
    search_hit {
        bigint search_id PK, FK
        int lecture_id PK, FK
        real score
        boolean is_locked
    }
